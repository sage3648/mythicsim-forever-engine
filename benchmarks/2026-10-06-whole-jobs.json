{
 "kind": "job_benchmark",
 "date": "2026-10-06",
 "scope": "Whole Quick Sim jobs of the 27 single-target production requests (fixtures/mage/prepared-v2/production-*.request.json) at 3000 iterations, the production Quick Sim size, run as the worker would from a bundle: Go as one pinned engine process on the request, Rust as tools/route.py with the Go exporter's prepare, the gate's check and the Rust simulation.",
 "method": "tools/job_bench.py interleaves the Go job, the routed Rust job and route.py's three steps on their own, three rounds per request; each figure is the median over the rounds. Wall time is measured around each process; CPU time and peak resident set come from wait4 and include every process a job waits for. Overhead is a job's wall time minus the engine's own iteration loop time. The throughput phase runs every request's job three times, four jobs at a time, in each engine.",
 "command": "python3 tools/job_bench.py --bundle ~/forever-shadow/bundle-5ed58e3 --output <scratch>/report.json --rounds 3 --iterations 3000 --concurrency 4",
 "source_revision": "5ed58e36fadf7e52beefc00961066f30cfdad3aa",
