package core

import "slices"

// Copied into the scratch reference checkout by tools/rust_data.py so tools/rust-data can read
// registries this package keeps unexported. It changes no behavior.

// The first preset target of each ID has an AI: GetPresetTargetWithID answers the first.
func RustDataPresetTargetsWithAI() []int32 {
	seen := map[int32]bool{}
	out := []int32{}
	for _, preset := range presetTargets {
		if seen[preset.Config.Id] {
			continue
		}
		seen[preset.Config.Id] = true
		if preset.AI != nil {
			out = append(out, preset.Config.Id)
		}
	}
	return out
}

// RustDataItemSet is a registered item set as Rust needs it: the names its items carry and the
// piece counts at which it has a bonus.
type RustDataItemSet struct {
	ID              int32   `json:"id"`
	Name            string  `json:"name"`
	AlternativeName string  `json:"alternative_name"`
	BonusPieces     []int32 `json:"bonus_pieces"`
}

// The sets NewItemSet registered, in registration order: the ones whose items the loaded
// database holds. getSetBonuses searches them in this order.
func RustDataItemSets() []RustDataItemSet {
	out := []RustDataItemSet{}
	for _, set := range sets {
		pieces := []int32{}
		for count := range set.Bonuses {
			pieces = append(pieces, count)
		}
		slices.Sort(pieces)
		out = append(out, RustDataItemSet{ID: set.ID, Name: set.Name, AlternativeName: set.AlternativeName, BonusPieces: pieces})
	}
	return out
}
